@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooking.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <div id="page-loading-overlay">
        <div class="spinner-border loader-spinner" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>

            <aside class="sidebar" id="sidebar">
                <div class="sidebar-brand">HotelBooking</div>

                <nav class="sidebar-nav">
                    <a class="sidebar-link @(IsActive("MeetingRoom", "Index") ? "active" : "")" asp-controller="MeetingRoom" asp-action="Index">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
                        <span>Room Catalog</span>
                    </a>
                    <a class="sidebar-link @(IsActive("Booking", "Index") ? "active" : "")" asp-controller="Booking" asp-action="Index">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>My Bookings</span>
                    </a>

                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="sidebar-section-title">Admin</div>
                        <a class="sidebar-link @(IsActive("Admin", "Dashboard") ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg>
                            <span>Dashboard</span>
                        </a>
                        <a class="sidebar-link @(IsActive("Admin", "AllRooms") ? "active" : "")" asp-controller="Admin" asp-action="AllRooms">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                            <span>All Rooms</span>
                        </a>
                        <a class="sidebar-link @(IsActive("Admin", "AllBookings") ? "active" : "")" asp-controller="Admin" asp-action="AllBookings">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="18" rx="2"></rect><path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></svg>
                            <span>All Bookings</span>
                        </a>
                        <a class="sidebar-link @(IsActive("Admin", "BookingHistory") ? "active" : "")" asp-controller="Admin" asp-action="BookingHistory">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>Booking History</span>
                        </a>
                    }
                </nav>

                <form asp-controller="Auth" asp-action="Logout" method="post" class="sidebar-logout">
                    <button type="submit" class="sidebar-link">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Log Out</span>
                    </button>
                </form>
            </aside>

            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success mt-3">@successMessage</div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success mt-3">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
