@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model HotelBooking.Web.Models.ViewModels.RoomAvailabilityViewModel

@{
    ViewData["Title"] = $"Availability - {Model.RoomName}";
}

<h1>@Model.RoomName</h1>
<p><a asp-controller="MeetingRoom" asp-action="Index">&larr; Back to Room Catalog</a></p>

<form asp-controller="MeetingRoom" asp-action="Availability" asp-route-id="@Model.RoomId" method="get" class="row g-2 mb-3">
    <input type="hidden" name="timeZoneId" value="@Model.TimeZoneId" />
    <div class="col-auto">
        <label class="form-label">Date</label>
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" min="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Duration (minutes)</label>
        <input type="number" name="durationMinutes" value="@Model.DurationMinutes" class="form-control" min="30" max="240" step="30" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Check Availability</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.TimeSlots is null || Model.TimeSlots.Count == 0)
{
    <p>No available time slots for this date and duration.</p>
}
else
{
    <ul class="list-group" style="max-width: 400px;">
        @foreach (var slot in Model.TimeSlots)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@slot.StartTime - @slot.EndTime</span>
                <form asp-controller="Booking" asp-action="Create" method="post">
                    <input type="hidden" name="RoomId" value="@Model.RoomId" />
                    <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="StartTime" value="@slot.StartTime.ToString("HH:mm:ss")" />
                    <input type="hidden" name="EndTime" value="@slot.EndTime.ToString("HH:mm:ss")" />
                    <input type="hidden" name="TimeZoneId" value="@Model.TimeZoneId" />
                    <button type="submit" class="btn btn-sm btn-success">Book this hour</button>
                </form>
            </li>
        }
    </ul>
}
