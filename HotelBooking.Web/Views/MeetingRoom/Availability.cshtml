@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model HotelBooking.Web.Models.ViewModels.RoomAvailabilityViewModel

@{
    ViewData["Title"] = $"Availability - {Model.RoomName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/availability.css" asp-append-version="true" />
}

<a asp-controller="MeetingRoom" asp-action="Index" class="back-link">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    Back to Room Catalog
</a>

<div class="availability-page">
<h1>@Model.RoomName</h1>

<form id="availabilityForm" asp-controller="MeetingRoom" asp-action="Availability" asp-route-id="@Model.RoomId" method="get" class="row g-2 mb-3 justify-content-center">
    <input type="hidden" name="timeZoneId" value="@Model.TimeZoneId" />
    <div class="col-auto">
        <label class="form-label">Date</label>
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" min="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Duration (minutes)</label>
        <input type="number" name="durationMinutes" value="@Model.DurationMinutes" class="form-control" min="30" max="240" step="30" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Check Availability</button>
    </div>
</form>

<div id="availabilityResults">
    @await Html.PartialAsync("_AvailabilityResults", Model)
</div>
</div>

<div class="modal fade" id="bookSlotModal" tabindex="-1" aria-labelledby="bookSlotModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Booking" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="bookSlotModalLabel">Book <span id="bookSlotLabel"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert d-none" id="bookSlotMessage" role="alert"></div>
                    <input type="hidden" name="RoomId" id="bookSlotRoomId" />
                    <input type="hidden" name="Date" id="bookSlotDate" />
                    <input type="hidden" name="StartTime" id="bookSlotStartTime" />
                    <input type="hidden" name="EndTime" id="bookSlotEndTime" />
                    <input type="hidden" name="TimeZoneId" id="bookSlotTimeZoneId" />
                    <div class="mb-3">
                        <label class="form-label">Attendees</label>
                        <input type="number" name="AttendeeCount" class="form-control" value="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Book this slot</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createRecurringModal" tabindex="-1" aria-labelledby="createRecurringModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Booking" asp-action="CreateRecurring" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="createRecurringModalLabel">Create Recurring Booking <span id="recurSlotLabel"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert d-none" id="recurMessage" role="alert"></div>
                    <input type="hidden" name="RoomId" id="recurRoomId" />
                    <input type="hidden" name="StartDate" id="recurStartDate" />
                    <input type="hidden" name="StartTime" id="recurStartTime" />
                    <input type="hidden" name="EndTime" id="recurEndTime" />
                    <input type="hidden" name="TimeZoneId" id="recurTimeZoneId" />
                    <div class="mb-3">
                        <label class="form-label">Attendees</label>
                        <input type="number" name="AttendeeCount" class="form-control" value="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="Notes" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Number of weekly occurrences</label>
                        <input type="number" name="OccurrenceCount" class="form-control" value="4" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white recurring-btn">Create Recurring Bookings</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/availability.js" asp-append-version="true"></script>
}
