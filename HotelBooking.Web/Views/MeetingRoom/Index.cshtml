@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model HotelBooking.Web.Models.ViewModels.RoomCatalogViewModel

@{
    ViewData["Title"] = "Room Catalog";
}

<h1>Room Catalog</h1>

<form id="roomSearchForm" asp-controller="MeetingRoom" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-auto">
        <input type="text" name="Location" value="@Model.Location" class="form-control" placeholder="Location" />
    </div>
    <div class="col-auto">
        <input type="number" name="MinCapacity" value="@Model.MinCapacity" class="form-control" placeholder="Min capacity" min="1" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-controller="MeetingRoom" asp-action="Index" class="btn btn-outline-secondary room-catalog-ajax-link">Clear</a>
    </div>
</form>

<div id="roomResults">
    @await Html.PartialAsync("_RoomCatalogResults", Model)
</div>

@section Scripts {
    <script src="~/js/room-catalog.js" asp-append-version="true"></script>
}
