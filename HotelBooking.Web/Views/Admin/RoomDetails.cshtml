@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model HotelBooking.Web.Models.Responses.MeetingRoomsResponse

@{
    ViewData["Title"] = "Room Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-rooms.css" asp-append-version="true" />
}

<a asp-controller="Admin" asp-action="AllRooms" class="back-link">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    Back to All Rooms
</a>

<div class="availability-page">
<h1>Room Details</h1>

<dl class="row detail-list">
    <dt class="col-sm-4">Room Id</dt>
    <dd class="col-sm-8">@Model.Id</dd>

    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8">@Model.Name</dd>

    <dt class="col-sm-4">Description</dt>
    <dd class="col-sm-8">@Model.Description</dd>

    <dt class="col-sm-4">Location</dt>
    <dd class="col-sm-8">@Model.Location</dd>

    <dt class="col-sm-4">Capacity</dt>
    <dd class="col-sm-8">@Model.Capacity</dd>

    <dt class="col-sm-4">Opening Time</dt>
    <dd class="col-sm-8">@Model.OpeningTime</dd>

    <dt class="col-sm-4">Closing Time</dt>
    <dd class="col-sm-8">@Model.ClosingTime</dd>

    <dt class="col-sm-4">Active</dt>
    <dd class="col-sm-8"><span class="status-badge @(Model.IsActive ? "status-badge-confirmed" : "status-badge-cancelled")">@(Model.IsActive ? "Yes" : "No")</span></dd>
</dl>

<button type="button" class="btn btn-warning edit-room-btn mt-3" data-bs-toggle="modal" data-bs-target="#editRoomModal">
    Edit
</button>
</div>

<div class="modal fade" id="editRoomModal" tabindex="-1" aria-labelledby="editRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="UpdateRoom" asp-route-id="@Model.Id" method="post" class="disable-on-submit">
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoomModalLabel">Edit Room</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" value="@Model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" name="Location" class="form-control" value="@Model.Location" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capacity</label>
                        <input type="number" name="Capacity" class="form-control" value="@Model.Capacity" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Opening Time</label>
                        <input type="time" name="OpeningTime" class="form-control" value="@Model.OpeningTime.ToString("HH:mm")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Closing Time</label>
                        <input type="time" name="ClosingTime" class="form-control" value="@Model.ClosingTime.ToString("HH:mm")" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editRoomIsActive" checked="@Model.IsActive" />
                        <label class="form-check-label" for="editRoomIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
