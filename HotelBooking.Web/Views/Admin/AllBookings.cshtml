@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using HotelBooking.Web.Models.Enums
@model List<HotelBooking.Web.Models.Responses.BookingResponse>

@{
    ViewData["Title"] = "All Bookings";
    var displayTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tbilisi");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string StatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "status-badge-pending",
        BookingStatus.Confirmed => "status-badge-confirmed",
        BookingStatus.Rejected => "status-badge-rejected",
        BookingStatus.Cancelled => "status-badge-cancelled",
        _ => ""
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
}

<h1 class="mb-3">All Bookings</h1>

<div class="bookings-card">
@if (Model.Count == 0)
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <p>No bookings found</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Booked By</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Attendees</th>
                    <th>Notes</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr data-booking-row>
                        <td><a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id">@booking.RoomName</a></td>
                        <td>@booking.UserFullName</td>
                        <td>@TimeZoneInfo.ConvertTimeFromUtc(booking.StartUtc, displayTimeZone).ToString("g")</td>
                        <td>@TimeZoneInfo.ConvertTimeFromUtc(booking.EndUtc, displayTimeZone).ToString("g")</td>
                        <td>@booking.AttendeeCount</td>
                        <td>@booking.Notes</td>
                        <td><span class="status-badge @StatusBadgeClass(booking.Status)">@booking.Status</span></td>
                        <td class="d-flex gap-2" data-booking-actions>
                            @if (booking.Status == BookingStatus.Pending)
                            {
                                <form asp-controller="Booking" asp-action="Confirm" asp-route-id="@booking.Id" method="post" class="d-inline booking-action-form" data-action-type="confirm">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn-confirm-action">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Confirm
                                    </button>
                                </form>
                                <form asp-controller="Booking" asp-action="Reject" asp-route-id="@booking.Id" method="post" class="d-inline booking-action-form" data-action-type="reject">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn-reject-action">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" stroke="none"><circle cx="12" cy="12" r="10"></circle><rect x="11" y="6.5" width="2" height="6" rx="1" fill="#1a1a1a"></rect><rect x="11" y="15" width="2" height="2" rx="1" fill="#1a1a1a"></rect></svg>
                                        Reject
                                    </button>
                                </form>
                            }
                            @if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Confirmed)
                            {
                                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="d-inline booking-action-form" data-action-type="cancel">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn-cancel-action">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@section Scripts {
    <script src="~/js/booking-actions.js" asp-append-version="true"></script>
}
